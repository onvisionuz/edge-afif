# Chocolate Counter - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# RTSP Camera Stream URL
# Format: rtsp://username:password@ip_address:port/stream_path
# Example: rtsp://admin:password123@192.168.1.100:554/Streaming/Channels/101
RTSP_URL=rtsp://user:password@192.168.1.100:554/stream
