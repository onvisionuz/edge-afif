# Chocolate Counter - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ==============================================================================
# RTSP CAMERA CONFIGURATION
# ==============================================================================
# RTSP Camera Stream URL
# Format: rtsp://username:password@ip_address:port/stream_path
# Example: rtsp://admin:password123@192.168.1.100:554/Streaming/Channels/101
RTSP_URL=rtsp://user:password@192.168.1.100:554/stream

# ==============================================================================
# BACKEND SERVER CONFIGURATION
# ==============================================================================
# Backend API endpoint for event delivery
# Production: http://api.onvision.uz/manufacturing/detect
# Development: http://localhost:8085/manufacturing/detect
SERVER_URL=http://api.onvision.uz/manufacturing/detect

# API key for authentication (obtain from admin dashboard)
# Format: mk_xxxxxxxxxxxxxxxx
API_KEY=mk_your_key_here

# Event batching configuration
FLUSH_INTERVAL_SECONDS=5
BATCH_SIZE=50

# ==============================================================================
# DEVICE IDENTITY & REGISTRATION
# ==============================================================================
# Manufacturer ID (must be registered in backend)
MANUFACTURE_ID=1

# Camera ID (must be registered in backend for this device)
CAMERA_ID=1

# Product ID (must be registered in backend, replaces product_type string)
PRODUCT_ID=1

# Unique device identifier (hostname or serial number)
DEVICE_ID=JetsonOrinNano-001

# Production line identifier (optional)
LINE_ID=Line 1
